# ===========================================
# ateli — environment variables (template)
# Copy to .env and fill in real values.
# Never commit .env.
# ===========================================

# --- Phase 0 (required) ---

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model selection (defaults to claude-opus-4-7)
ATELI_MODEL=claude-opus-4-7

# Max tokens per agent response
ATELI_MAX_TOKENS=8192

# Hard cap on agent loop iterations (defensive)
ATELI_MAX_TURNS=50

# Per-bash command timeout (ms)
ATELI_BASH_TIMEOUT_MS=120000

# Where ateli stores its sqlite DB and run logs.
# Defaults to ./.ateli relative to cwd.
ATELI_DATA_DIR=.ateli

# Log level: trace | debug | info | warn | error
ATELI_LOG_LEVEL=info

# --- Phase 2 ---

# Per-task USD budget (0 disables). The agent loop stops and emits
# budget_exceeded once the running tally crosses this. Can also be
# overridden per task via the CLI --budget flag or API budget_usd field.
ATELI_BUDGET_PER_TASK_USD=0

# When set to "1", every /v1/* HTTP request requires a valid Bearer token.
# Issue tokens with: `ateli token create --user <id> --name <name> --scope write`
ATELI_REQUIRE_AUTH=0

# When set to "1", `ateli serve` does NOT auto-start an embedded worker.
# Use this in production where you run `ateli worker` separately.
ATELI_DISABLE_EMBEDDED_WORKER=0

# --- Phase 1 (required when surfaces enabled) ---

# HTTP API
ATELI_HTTP_PORT=4000
ATELI_HTTP_HOST=0.0.0.0

# Voyage AI for code embeddings (https://www.voyageai.com/)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-code-3

# Slack (https://api.slack.com/apps — create app, enable Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub — personal access token with `repo` scope
GITHUB_TOKEN=
# Default committer identity used when ateli pushes code
GITHUB_COMMITTER_NAME=ateli-bot
GITHUB_COMMITTER_EMAIL=ateli-bot@users.noreply.github.com
